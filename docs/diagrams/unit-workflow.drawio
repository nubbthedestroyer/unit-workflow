<mxfile host="app.diagrams.net" agent="drawio_builder" type="device">
  <diagram id="d1" name="Architecture">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="_title" value="The Unit Workflow" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="900" height="32" as="geometry" /></mxCell>
        <mxCell id="_subtitle" value="How one request becomes shipped code — small briefs, fresh workers, nobody checks their own work, everything written down" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="900" height="22" as="geometry" /></mxCell>
        <mxCell id="people" value="People" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fillColor=none;strokeColor=#879196;fontColor=#5A6C74;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="300" height="420" as="geometry" /></mxCell>
        <mxCell id="you" value="&lt;b&gt;You&lt;/b&gt;&lt;br/&gt;say what you want;&lt;br/&gt;decide only the big things&lt;br/&gt;(drop a feature, spend money,&lt;br/&gt;change a public door)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#E7157B;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="240" height="110" as="geometry" /></mxCell>
        <mxCell id="foreman" value="&lt;b&gt;The foreman&lt;/b&gt;&lt;br/&gt;(the assistant you talk to)&lt;br/&gt;writes the brief, hands out work,&lt;br/&gt;reads reports, keeps the ledger.&lt;br/&gt;&lt;i&gt;Never touches the tools.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#E7157B;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="330" width="240" height="130" as="geometry" /></mxCell>
        <mxCell id="unit" value="One unit — runs in the background, one fresh worker per step" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fillColor=none;strokeColor=#879196;fontColor=#5A6C74;fontSize=13;" vertex="1" parent="1"><mxGeometry x="380" y="110" width="1280" height="420" as="geometry" /></mxCell>
        <mxCell id="contract" value="&lt;b&gt;1. Brief&lt;/b&gt;&lt;br/&gt;one-page contract:&lt;br/&gt;your words, files it owns,&lt;br/&gt;files it must not touch,&lt;br/&gt;how to prove it works" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FF;strokeColor=#C925D1;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="160" width="200" height="120" as="geometry" /></mxCell>
        <mxCell id="builder" value="&lt;b&gt;2. Builder&lt;/b&gt;&lt;br/&gt;works in its own copy&lt;br/&gt;of the code (a worktree);&lt;br/&gt;cannot break anything live" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3FBF3;strokeColor=#ED7100;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="160" width="200" height="120" as="geometry" /></mxCell>
        <mxCell id="checker" value="&lt;b&gt;3. Checker&lt;/b&gt;&lt;br/&gt;reads the same brief,&lt;br/&gt;runs the proofs, clicks&lt;br/&gt;through the app, reports&lt;br/&gt;file + line for every finding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3F0;strokeColor=#DD344C;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="160" width="200" height="120" as="geometry" /></mxCell>
        <mxCell id="fixer" value="&lt;b&gt;4. Fixer&lt;/b&gt;&lt;br/&gt;repairs what the checker&lt;br/&gt;found; the checker looks&lt;br/&gt;again (max two rounds)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3F0;strokeColor=#DD344C;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="330" width="200" height="100" as="geometry" /></mxCell>
        <mxCell id="tier2" value="&lt;b&gt;5. Second checker&lt;/b&gt;&lt;br/&gt;&lt;i&gt;risky units only&lt;/i&gt;: money,&lt;br/&gt;sign-in, tenant isolation,&lt;br/&gt;ingestion, public doors —&lt;br/&gt;tries to refute it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3F0;strokeColor=#DD344C;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1130" y="160" width="200" height="120" as="geometry" /></mxCell>
        <mxCell id="merger" value="&lt;b&gt;6. Merger&lt;/b&gt;&lt;br/&gt;folds the branch into&lt;br/&gt;main — one unit at a time,&lt;br/&gt;never two racing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1370" y="160" width="200" height="120" as="geometry" /></mxCell>
        <mxCell id="inspector" value="&lt;b&gt;7. Inspector&lt;/b&gt;&lt;br/&gt;runs the whole build + test&lt;br/&gt;suite on main; explains any&lt;br/&gt;failure: new, or old noise?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1370" y="330" width="200" height="120" as="geometry" /></mxCell>
        <mxCell id="ship" value="&lt;b&gt;8. Ship&lt;/b&gt;&lt;br/&gt;migrations applied to&lt;br/&gt;production, deploy runs,&lt;br/&gt;ledger records the outcome" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#E7157B;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1370" y="600" width="200" height="100" as="geometry" /></mxCell>
        <mxCell id="disk" value="Truth lives on disk (docs/plan) — not in anyone's memory" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fillColor=none;strokeColor=#879196;fontColor=#5A6C74;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1280" height="170" as="geometry" /></mxCell>
        <mxCell id="f_contract" value="&lt;b&gt;contracts/NN-*.md&lt;/b&gt;&lt;br/&gt;the brief for every unit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FF;strokeColor=#C925D1;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="810" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="f_units" value="&lt;b&gt;units.json&lt;/b&gt;&lt;br/&gt;registry the status tools read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FF;strokeColor=#C925D1;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="810" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="f_ledger" value="&lt;b&gt;ledger.md&lt;/b&gt;&lt;br/&gt;one row per unit + every&lt;br/&gt;check, fix, merge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FF;strokeColor=#C925D1;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="810" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="f_resume" value="&lt;b&gt;resume.md&lt;/b&gt;&lt;br/&gt;where the last session stopped;&lt;br/&gt;a new session reads it first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FF;strokeColor=#C925D1;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="810" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="f_journal" value="&lt;b&gt;run journal (wf_…)&lt;/b&gt;&lt;br/&gt;what every worker returned;&lt;br/&gt;resumable from cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FF;strokeColor=#C925D1;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1070" y="810" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="t_foreman_disk" value="The foreman reads and writes these; workers append their reports." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="380" y="728" width="600" height="24" as="geometry" /></mxCell>
        <mxCell id="rules" value="&lt;b&gt;Four rules&lt;/b&gt;&lt;br/&gt;1. Small, named pieces — one feature or fix, never “the whole app”.&lt;br/&gt;2. Fresh eyes every time — each step is a new worker with a short brief.&lt;br/&gt;3. Nobody grades their own homework — builder and checker are never the same.&lt;br/&gt;4. Truth on disk — status and decisions are files in the repo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;fontColor=#232F3E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="600" height="140" as="geometry" /></mxCell>
        <mxCell id="engine" value="&lt;b&gt;Under the hood&lt;/b&gt;&lt;br/&gt;One Claude Code dynamic workflow run (docs/plan/round2-workflow.js) drives steps 2–7 as agent() calls:&lt;br/&gt;Opus everywhere, max three at once, tool-call caps per role, worktree isolation, JSON report schema.&lt;br/&gt;“status?” joins the run journals with units.json to show each unit's stage." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="570" width="640" height="140" as="geometry" /></mxCell>
        <mxCell id="e1" value="“the drop zone should stay active”" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=0;strokeColor=#232F3E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;spacing=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="you" target="foreman"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=0;strokeColor=#232F3E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;spacing=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="foreman" target="contract"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=0;strokeColor=#232F3E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;spacing=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="contract" target="builder"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="branch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=0;strokeColor=#232F3E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;spacing=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="builder" target="checker"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="refuted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=0;strokeColor=#B7472A;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#B7472A;labelBackgroundColor=#FFFFFF;spacing=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="checker" target="fixer"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="re-check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=0;strokeColor=#B7472A;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#B7472A;labelBackgroundColor=#FFFFFF;spacing=4;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="fixer" target="checker"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="confirmed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=0;strokeColor=#232F3E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;spacing=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="checker" target="tier2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="confirmed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=0;strokeColor=#232F3E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;spacing=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tier2" target="merger"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="main" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=0;strokeColor=#232F3E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;spacing=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="merger" target="inspector"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="green" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=0;strokeColor=#232F3E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;spacing=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="inspector" target="ship"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="report" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#232F3E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;spacing=4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="inspector" target="f_journal"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1340" y="390" /><mxPoint x="1340" y="850" /></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
