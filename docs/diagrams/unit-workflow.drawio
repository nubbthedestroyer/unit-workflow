<mxfile host="app.diagrams.net" agent="drawio_builder" type="device">
  <diagram id="d1" name="Architecture">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="_title" value="The unit workflow" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="900" height="32" as="geometry" /></mxCell>
        <mxCell id="_subtitle" value="One request becomes shipped code: small brief, fresh workers, nobody checks their own work, everything written down" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="900" height="22" as="geometry" /></mxCell>
        <mxCell id="people" value="People" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fillColor=none;strokeColor=#879196;fontColor=#5A6C74;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="300" height="420" as="geometry" /></mxCell>
        <mxCell id="you" value="&lt;b&gt;You&lt;/b&gt;&lt;br/&gt;Say what you want.&lt;br/&gt;Decide only the big things." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#E7157B;fontColor=#232F3E;fontSize=15;" vertex="1" parent="1"><mxGeometry x="55" y="150" width="250" height="105" as="geometry" /></mxCell>
        <mxCell id="foreman" value="&lt;b&gt;The foreman&lt;/b&gt;&lt;br/&gt;Writes the brief, hands out&lt;br/&gt;work, keeps the ledger.&lt;br/&gt;&lt;i&gt;Never touches the tools.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#E7157B;fontColor=#232F3E;fontSize=15;" vertex="1" parent="1"><mxGeometry x="55" y="330" width="250" height="130" as="geometry" /></mxCell>
        <mxCell id="unit" value="One unit: runs in the background, one fresh worker per step" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fillColor=none;strokeColor=#879196;fontColor=#5A6C74;fontSize=13;" vertex="1" parent="1"><mxGeometry x="360" y="100" width="1170" height="420" as="geometry" /></mxCell>
        <mxCell id="brief" value="&lt;b&gt;1. Brief&lt;/b&gt;&lt;br/&gt;One page: your words,&lt;br/&gt;files it owns, files it&lt;br/&gt;must not touch, the proof." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FF;strokeColor=#C925D1;fontColor=#232F3E;fontSize=15;" vertex="1" parent="1"><mxGeometry x="385" y="150" width="200" height="110" as="geometry" /></mxCell>
        <mxCell id="builder" value="&lt;b&gt;2. Builder&lt;/b&gt;&lt;br/&gt;Works in its own copy&lt;br/&gt;of the code. Cannot&lt;br/&gt;break anything live." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3FBF3;strokeColor=#ED7100;fontColor=#232F3E;fontSize=15;" vertex="1" parent="1"><mxGeometry x="615" y="150" width="200" height="110" as="geometry" /></mxCell>
        <mxCell id="checker" value="&lt;b&gt;3. Checker&lt;/b&gt;&lt;br/&gt;Runs the proof, clicks&lt;br/&gt;through the app, reports&lt;br/&gt;file + line per finding." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3F0;strokeColor=#DD344C;fontColor=#232F3E;fontSize=15;" vertex="1" parent="1"><mxGeometry x="845" y="150" width="200" height="110" as="geometry" /></mxCell>
        <mxCell id="tier2" value="&lt;b&gt;5. Second checker&lt;/b&gt;&lt;br/&gt;Risky units only.&lt;br/&gt;Its job is to refute." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3F0;strokeColor=#DD344C;fontColor=#232F3E;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1075" y="150" width="200" height="110" as="geometry" /></mxCell>
        <mxCell id="merger" value="&lt;b&gt;6. Merger&lt;/b&gt;&lt;br/&gt;Folds the branch into&lt;br/&gt;main, one unit at a time." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1305" y="150" width="200" height="110" as="geometry" /></mxCell>
        <mxCell id="fixer" value="&lt;b&gt;4. Fixer&lt;/b&gt;&lt;br/&gt;Repairs what the checker&lt;br/&gt;found. Max two rounds." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3F0;strokeColor=#DD344C;fontColor=#232F3E;fontSize=15;" vertex="1" parent="1"><mxGeometry x="845" y="340" width="200" height="110" as="geometry" /></mxCell>
        <mxCell id="inspector" value="&lt;b&gt;7. Inspector&lt;/b&gt;&lt;br/&gt;Runs the whole test suite&lt;br/&gt;on main. New failure, or&lt;br/&gt;old noise?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1075" y="340" width="200" height="110" as="geometry" /></mxCell>
        <mxCell id="ship" value="&lt;b&gt;8. Ship&lt;/b&gt;&lt;br/&gt;Migrations, deploy,&lt;br/&gt;ledger records it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#E7157B;fontColor=#232F3E;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1305" y="340" width="200" height="110" as="geometry" /></mxCell>
        <mxCell id="disk" value="Truth lives on disk, not in anyone's memory" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fillColor=none;strokeColor=#879196;fontColor=#5A6C74;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="560" width="1500" height="200" as="geometry" /></mxCell>
        <mxCell id="f_contract" value="&lt;b&gt;contracts/&lt;/b&gt;&lt;br/&gt;the brief for every unit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FF;strokeColor=#C925D1;fontColor=#232F3E;fontSize=15;" vertex="1" parent="1"><mxGeometry x="55" y="620" width="270" height="90" as="geometry" /></mxCell>
        <mxCell id="f_units" value="&lt;b&gt;units.json&lt;/b&gt;&lt;br/&gt;the registry status tools read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FF;strokeColor=#C925D1;fontColor=#232F3E;fontSize=15;" vertex="1" parent="1"><mxGeometry x="350" y="620" width="270" height="90" as="geometry" /></mxCell>
        <mxCell id="f_ledger" value="&lt;b&gt;ledger.md&lt;/b&gt;&lt;br/&gt;one row per unit, every&lt;br/&gt;check, fix and merge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FF;strokeColor=#C925D1;fontColor=#232F3E;fontSize=15;" vertex="1" parent="1"><mxGeometry x="645" y="620" width="270" height="90" as="geometry" /></mxCell>
        <mxCell id="f_resume" value="&lt;b&gt;resume.md&lt;/b&gt;&lt;br/&gt;where the last session stopped;&lt;br/&gt;a new one reads it first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FF;strokeColor=#C925D1;fontColor=#232F3E;fontSize=15;" vertex="1" parent="1"><mxGeometry x="940" y="620" width="270" height="90" as="geometry" /></mxCell>
        <mxCell id="f_journal" value="&lt;b&gt;run journal&lt;/b&gt;&lt;br/&gt;what every worker returned;&lt;br/&gt;resumable from cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FF;strokeColor=#C925D1;fontColor=#232F3E;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1235" y="620" width="270" height="90" as="geometry" /></mxCell>
        <mxCell id="t_disk" value="The foreman reads and writes these. Workers append their reports. Nothing lives only in a chat." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=13;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="730" width="1500" height="24" as="geometry" /></mxCell>
        <mxCell id="e1" value="one request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=0;strokeColor=#232F3E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;spacing=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="you" target="foreman"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=0;strokeColor=#232F3E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;spacing=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="foreman" target="brief"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=0;strokeColor=#232F3E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;spacing=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="brief" target="builder"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=0;strokeColor=#232F3E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;spacing=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="builder" target="checker"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="refuted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=0;strokeColor=#B7472A;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#B7472A;labelBackgroundColor=#FFFFFF;spacing=4;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.35;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="checker" target="fixer"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="re-check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=0;strokeColor=#B7472A;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#B7472A;labelBackgroundColor=#FFFFFF;spacing=4;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="fixer" target="checker"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="ok" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=0;strokeColor=#232F3E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;spacing=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="checker" target="tier2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="ok" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=0;strokeColor=#232F3E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;spacing=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tier2" target="merger"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="main" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=0;strokeColor=#232F3E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;spacing=4;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="merger" target="inspector"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1290" y="243" /><mxPoint x="1290" y="395" /></Array></mxGeometry></mxCell>
        <mxCell id="e10" value="green" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=0;strokeColor=#232F3E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;spacing=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="inspector" target="ship"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
